GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemma-3-27b-it
CAMERAS_CSV=data/metadata/cameras_sample40.csv

# Start the camera sweep with the service instead of POSTing /api/jobs/start.
# Leave it unset for tests and local runs, which should not sweep the city's
# public camera site just by starting the app.
FETCH_AUTOSTART=1

# Tan Son Nhat arrivals/departures for the 3D map come from
# scripts/tia_poller.py, which scrapes the airport's own live flight board
# (tia.vietnamairport.vn). No key needed; run it alongside the service --
# see 3d/README.md. These two only need setting if the defaults don't fit:
# TIA_STORE_PATH=data/derived/flights_tia.json
# TIA_STALE_MINUTES=14
