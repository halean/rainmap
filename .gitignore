.venv/
__pycache__/
*.pyc
.env

# camera imagery -- large and continuously regenerated by the fetch job
data/raw/

# one-off storm-capture test sets used for vision-LLM cost/quality comparisons --
# same reasoning as data/raw/, large and reproducible via scripts/storm_snapshot.py
data/test_sets/

# service logs (rotated in place) and the append-only reading history: both grow
# continuously, so they're operational data rather than anything to version
logs/
data/derived/rain_history.csv
data/derived/vrain_history.csv
data/derived/lightning_vn_history.csv
data/derived/lightning_vn_strikes_history.csv
# cached model perceptions keyed by frame path -- regenerated on demand by
# scripts/perception_eval.py, and it grows with every frame ever scored
data/derived/perception_cache.json
NOTES.md

# rendered satellite frames -- a rolling window, refetched from NOAA on demand
data/derived/himawari/

# recoloured radar frames -- a rolling 48 h window, refetched from HYMETNET on demand
data/derived/radar_nhb/

# Generated 3D map models and build inputs; rebuild with 3d/tools/build.py.
/3d/assets/
/3d/build-cache/
/3d/.venv-build/
/3d/**/*.osm.pbf

# arrivals/departures cache for the 3D airport animation -- refetched from the METAR API
# and rebuilt continuously by scripts/tia_poller.py's scrape of the live flight board
data/derived/flights/
data/derived/flights_tia.json

# per-camera recent-readings index, rebuilt from rain_history.csv by scripts/backfill_recent.py
data/derived/recent/
