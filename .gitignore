.venv/
__pycache__/
*.pyc
.env

# camera imagery -- large and continuously regenerated by the fetch job
data/raw/

# data/test_sets/ IS versioned (since 2026-10-06): it holds the hand labels
# (20261003_rain7d/hand_labels*) that every rain-reader evaluation is scored against,
# which cannot be regenerated. The labels point at frames in data/raw/ by path.

# frames kept by the flood-watch experiment (scripts/flood_watch.py) -- same reasoning as data/raw/
data/flood_watch/

# service logs, rotated in place -- operational data, not anything to version
logs/
NOTES.md

# 3D build inputs and caches. In 3d/assets/ the generated models (.glb) and data
# (.json: the manifest, cameras, streets) are versioned; the preview images are
# not. Rebuild them with 3d/tools/build.py and the tools beside it.
/3d/assets/*
!/3d/assets/*.glb
!/3d/assets/*.json
!/3d/assets/LICENSE.md
!/3d/assets/tiles/
/3d/assets/tiles/*
!/3d/assets/tiles/*.glb
/3d/build-cache/
/3d/.venv-build/
/3d/**/*.osm.pbf

# everything the services produce as they run: readings and their histories,
# the camera sample and watchdog state, satellite/radar frames, flight and metro
# caches. Operational data kept on disk, not versioned. camera_locations.json is
# the exception -- the city's full camera list, an input nothing regenerates.
data/derived/*
!data/derived/camera_locations.json

# WeatherNext 3 runs pulled by weathernext3/poller.py (~3 MB a day); data, not versioned.
weathernext3/runs/
